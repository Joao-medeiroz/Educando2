# Copie para backend/.env (só no seu computador). Nunca coloque a chave real em arquivos versionados.
GEMINI_API_KEY=cole-sua-chave-aqui
GEMINI_MODEL=gemini-3.5-flash-lite
RATE_LIMIT_POR_MINUTO=10
# Só para desenvolvimento local, quando o front roda em outra porta (ex.: http://127.0.0.1:5500)
ALLOWED_ORIGINS=
